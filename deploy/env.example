# Copiar para .env na RAIZ do projeto no servidor (chmod 600).
# O docker-compose lê este arquivo; nada de segredo entra no git.

# Chave da API Claude — usada pela IA de interpretação e pelo agente.
ANTHROPIC_API_KEY=

# Transcrição de áudio (já vem instalada na imagem).
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODELO=/opt/whisper-models/ggml-small.bin
FFMPEG_BIN=/usr/bin/ffmpeg

# Acesso ao Mac para os comandos que dependem dele (claude:, ideia:, relatorio,
# verificação diária, diagnóstico). É o nome do host no Tailscale, com usuário.
# Deixe vazio para desligar esses comandos.
MAC_SSH_HOST=luisazvedo@luis-mac
MAC_HOME=/Users/luisazvedo

# Alertas de infraestrutura (QR expirado, Google fora) — casos em que não dá
# para avisar pelo próprio WhatsApp. Escolha um tópico secreto e assine ele no
# app ntfy do celular: https://ntfy.sh/<seu-topico>
NTFY_TOPIC=

# Opcionais (têm padrão no config.js)
# BOT_LANG=pt-BR
# WHATSAPP_GRUPO=N O X X B O T ⚡️
# CLAUDE_BRIDGE_MODEL=sonnet
# VERIFICACAO_MODEL=haiku
